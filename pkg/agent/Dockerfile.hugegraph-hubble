# Build the unit-agent binary.
FROM golang:1.24.6 AS agent-builder

ARG TARGETOS
ARG TARGETARCH

ENV GO111MODULE=on

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY api/ api/
COPY pkg pkg/
COPY .git .git

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o dist/unit-agent \
    -ldflags "-s -w" \
    -ldflags "-X 'github.com/upmio/unit-operator/pkg/agent/version.GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)' -X 'github.com/upmio/unit-operator/pkg/agent/version.GIT_COMMIT=$(git rev-parse HEAD)' -X 'github.com/upmio/unit-operator/pkg/agent/version.BUILD_TIME=$(date '+%Y-%m-%d %H:%M:%S')' -X 'github.com/upmio/unit-operator/pkg/agent/version.GO_VERSION=$(go version | grep -o  'go[0-9].[0-9].*')'" \
    pkg/agent/main.go

# HugeGraph 1.3.0 does not ship the backup tooling in the server or Hubble
# image. Build the official tools distribution in a separate stage so the
# Hubble-specific unit-agent can perform logical graph backup and restore.
FROM maven:3.9.0-eclipse-temurin-11 AS hugegraph-tools-builder

ARG HUGEGRAPH_VERSION=1.3.0

RUN set -eux; \
    apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update; \
    apt-get install -y --no-install-recommends git; \
    rm -rf /var/lib/apt/lists/*; \
    git clone --depth 1 --branch "${HUGEGRAPH_VERSION}" https://github.com/apache/hugegraph-toolchain.git /src

WORKDIR /src

RUN mvn install -pl hugegraph-client -am -Dmaven.javadoc.skip=true -DskipTests -ntp
RUN cd hugegraph-tools \
    && mvn package -B -ntp -DskipTests -Dmaven.javadoc.skip=true

FROM eclipse-temurin:11-jre-jammy

USER root

RUN set -eux; \
    apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update; \
    apt-get install -y --no-install-recommends bash ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --system --gid 1001 unit-agent; \
    useradd --system --uid 1001 --gid 1001 --create-home --shell /usr/sbin/nologin unit-agent

COPY --from=agent-builder /workspace/dist/unit-agent /usr/local/bin/unit-agent
COPY --from=agent-builder /workspace/pkg/agent/etc/config.toml /opt/unit-agent/config.toml
COPY --from=hugegraph-tools-builder /src/hugegraph-tools/apache-hugegraph-tools-incubating-1.3.0/ /opt/hugegraph-tools/

RUN set -eux; \
    chmod 0755 /usr/local/bin/unit-agent /opt/hugegraph-tools/bin/hugegraph; \
    chown -R unit-agent:unit-agent /home/unit-agent /opt/unit-agent /opt/hugegraph-tools

ENV TZ=Asia/Shanghai \
    HUGEGRAPH_TOOLS_HOME=/opt/hugegraph-tools

WORKDIR /home/unit-agent

CMD ["unit-agent", "daemon", "-f", "/opt/unit-agent/config.toml"]

USER unit-agent
EXPOSE 2214
